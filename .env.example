# Local development only. No cloud credentials or GPU are needed.
ENVIRONMENT=development
AI_PROVIDER=mock
DEV_AUTH_ENABLED=true
POSTGRES_DB=ayna
POSTGRES_USER=ayna
POSTGRES_PASSWORD=ayna-local-only-change-me
S3_ACCESS_KEY=ayna-local
S3_SECRET_KEY=ayna-local-only-change-me
S3_BUCKET=ayna-private
ASSET_SIGNING_KEY=ayna-local-signing-key-change-before-production
CORS_ORIGINS=["http://localhost:5173"]
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
QUALITY_DEVICE=cpu
QUALITY_MAX_IMAGE_SIZE=384
QUALITY_ENABLE_SAM2=false
QUALITY_ENABLE_DINOV2=false
# QUALITY_SAM2_CHECKPOINT=C:\path\outside\the\repository\sam2.1_hiera_tiny.pt
# QUALITY_DINOV2_MODEL_PATH=C:\path\outside\the\repository\dinov2-small
VITE_API_BASE_URL=http://localhost:8000
API_PORT=8000
WEB_PORT=5173
# For a local R2 adapter set S3_ENDPOINT_URL, S3_REGION and private bucket credentials.
# Production auth is intentionally not implemented in the bootstrap.
